+export function buildCacheBustedWebappUrl(
+  webappUrl: string,
+  cacheBustValue: number | string = Date.now()
+): string {
+  const trimmedUrl = webappUrl.trim();
+  if (!trimmedUrl) {
+    return trimmedUrl;
+  }
+
+  const cacheBust = String(cacheBustValue);
+  try {
+    const parsedUrl = new URL(trimmedUrl);
+    parsedUrl.searchParams.set('v', cacheBust);
+    return parsedUrl.toString();
+  } catch {
+    const hashIndex = trimmedUrl.indexOf('#');
+    const beforeHash = hashIndex >= 0 ? trimmedUrl.slice(0, hashIndex) : trimmedUrl;
+    const hash = hashIndex >= 0 ? trimmedUrl.slice(hashIndex) : '';
+    const separator = beforeHash.includes('?') ? '&' : '?';
+    return `${beforeHash}${separator}v=${encodeURIComponent(cacheBust)}${hash}`;
+  }
+}
+
 export function formatWebappReleaseVersion(packageVersion: string): string {
   const normalizedPackageVersion = packageVersion.trim().replace(/^v/i, '');
   return normalizedPackageVersion ? `v${normalizedPackageVersion}` : 'v0.0.0';
